# Beevil Knievel Linux Edge Gateway Server - Environment Configuration
# Copy this file to .env and adjust values for your environment.

# Operational Mode
# Set to 'true' to pre-seed 100 simulated demo hives for testing / exhibition.
# Set to 'false' for live field deployment with real hardware nodes.
BEEVIL_DEMO_MODE=true

# Database Storage Path (SQLite WAL mode)
BEEVIL_DB_PATH=gateway/beevil_telemetry.db

# Edge AI Model Artifact (TorchScript JIT model; if absent, falls back to deterministic decision engine)
BEEVIL_MODEL_PATH="Cloud Model/beevil_fusion_net_edge_torchscript.pt"

# Server Host and Port
BEEVIL_API_HOST=0.0.0.0
BEEVIL_API_PORT=8000

# CORS Allowed Origins (comma-separated, without trailing slashes)
# In production, specify exact frontend origins (e.g., http://192.168.1.50:3000)
BEEVIL_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000

# Logging Level (debug, info, warning, error)
BEEVIL_LOG_LEVEL=info
