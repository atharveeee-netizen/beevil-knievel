[Unit]
Description=Beevil Knievel Automated Telegram Alert Bot Daemon
After=beevil-gateway.service
Requires=beevil-gateway.service

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/beevil-knievel/gateway
Environment="BEEVIL_TELEGRAM_TOKEN=YOUR_BOT_TOKEN_HERE"
Environment="BEEVIL_TELEGRAM_CHAT_ID=YOUR_CHAT_ID_HERE"
ExecStart=/home/pi/beevil-knievel/venv/bin/python telegram_notifier.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
